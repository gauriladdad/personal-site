# .env.example
# Public variables are exposed to client-side code. Do NOT store secrets here.

# Show the AWS-expired / development notice on the site.
# Set to false to hide the banner.
PUBLIC_SHOW_AWS_EXPIRED=true

# Public S3 base URL used by the frontend to fetch JSON (index.json, archives).
PUBLIC_S3_BUCKET_URL=https://your-bucket.s3.amazonaws.com

# Lambda/backend variables (example):
# S3_BUCKET_NAME=personal-site-news
# GEMINI_API_KEYS=key1,key2,..
